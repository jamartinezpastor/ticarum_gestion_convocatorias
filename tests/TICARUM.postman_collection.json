    {
      "name": "3 · Inscripciones · happy path",
      "item": [
        {
          "name": "POST /convocatorias/4/inscripciones (Pablo → BD → 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve inscripcion_id', () => pm.expect(body).to.have.property('inscripcion_id'));",
                  "pm.collectionVariables.set('lastInscripcionId', body.inscripcion_id);",
                  "console.log('Guardada inscripcion_id =', body.inscripcion_id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alumno_id\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/convocatorias/4/inscripciones",
